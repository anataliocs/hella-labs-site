{
  "name": "hella-labs-site",
  "type": "module",
  "packageManager": "pnpm@10.6.0",
  "engines": {
    "node": ">=26.3.0"
  },
  "version": "1.0.0",
  "description": "Hella Labs Website",
  "scripts": {
    "dev": "astro dev",
    "dev:worker": "astro build && wrangler dev",
    "start": "astro dev stop && pnpm lint:fix && pnpm format && astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "astro": "astro",
    "check": "astro check && tsc -p worker",
    "types": "wrangler types",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm run check && pnpm run lint && pnpm run format:check && pnpm run build"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.5",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@tailwindcss/vite": "^4.3.5",
    "alpinejs": "^3.17.5",
    "astro": "^7.2.1",
    "astro-icon": "^1.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/alpinejs": "^3.17.0",
    "astro-llms-md": "^3.0.3",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript-eslint": "^8.72.2",
    "wrangler": "^4.162.0"
  },
  "overrides": {
    "vite": "^8"
  }
}
