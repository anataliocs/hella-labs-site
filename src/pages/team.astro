---
// Team page (content in src/content/pages/team.mdx)
import { getEntry, render } from "astro:content";
import MainLayout from "@src/layouts/MainLayout.astro";
import PageShell from "@src/components/PageShell.astro";
import PageHeader from "@src/components/page/PageHeader.astro";
import ContentSection from "@src/components/page/ContentSection.astro";
import { webPageJsonLd, withBrand } from "@src/utils/seo";

const page = await getEntry("pages", "team");
if (!page) throw new Error("Missing src/content/pages/team.mdx");
const { Content } = await render(page);
const { title, description, image, imageAlt, icon } = page.data;
---

<MainLayout
  title={withBrand(title)}
  description={description}
  image={image}
  imageAlt={imageAlt}
  jsonLd={webPageJsonLd({ title, description, path: "/team/" })}
>
  <PageShell>
    <article>
      <PageHeader title={title} image={image} imageAlt={imageAlt} icon={icon} />
      <ContentSection content={Content} />
    </article>
  </PageShell>
</MainLayout>
