---
// Posts for one topic
import MainLayout from "@src/layouts/MainLayout.astro";
import PageShell from "@src/components/PageShell.astro";
import ArticleCard from "@src/components/blog/ArticleCard.astro";
import { getPosts, getTags, postsWithTag } from "@src/utils/posts";
import { breadcrumbJsonLd, withBrand } from "@src/utils/seo";

export async function getStaticPaths() {
  const posts = await getPosts();
  return getTags(posts).map((tag) => ({
    params: { tag: tag.slug },
    props: { tag, posts: postsWithTag(posts, tag.slug) },
  }));
}

const { tag, posts } = Astro.props;
const label = posts.length === 1 ? "Post" : "Posts";
---

<MainLayout
  title={withBrand(`${tag.name} Articles`)}
  description={`${posts.length} Hella Labs ${label.toLowerCase()} about ${tag.name}: ${posts.map((p) => p.data.title).join("; ")}.`}
  jsonLd={breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "Topics", path: "/tags/" },
    { name: tag.name, path: `/tags/${tag.slug}/` },
  ])}
>
  <PageShell>
    <div class="mb-8 rounded-2xl border border-line bg-surface-muted p-8">
      <h1 class="mb-1 text-5xl max-sm:text-[2rem]">{tag.name}</h1>
      <p class="mb-0">
        A collection of{" "}
        <span class="font-semibold text-heading">
          {posts.length} {label}
        </span>
      </p>
    </div>
    <div class="grid gap-8 md:grid-cols-2">
      {posts.map((post) => (
        <ArticleCard post={post} headingLevel="h2" />
      ))}
    </div>
  </PageShell>
</MainLayout>
