---
// Blog archive: every post grouped by year and month
import MainLayout from "@src/layouts/MainLayout.astro";
import Container from "@src/components/Container.astro";
import OptimizedImage from "@src/components/OptimizedImage.astro";
import { siteData } from "@src/data/siteData";
import { url } from "@src/utils/path";
import { formatDate, getPosts, groupByYearAndMonth, postPath, readingTime } from "@src/utils/posts";
import { withBrand } from "@src/utils/seo";

const posts = await getPosts();
const years = groupByYearAndMonth(posts);
const title = siteData.blog.title;
const countClass = "text-base font-medium text-fg-muted";
---

<MainLayout
  title={withBrand(title)}
  description="Every Topic Zero article from Hella Labs: Web3 and Ethereum engineering, smart contract testing, reactive dApps, CSS craft and open-source tooling."
>
  <Container as="section" class="mb-15 sm:mb-20">
    <div class="mx-auto max-w-6xl">
      <header class="mb-8 border-b border-line">
        <h1 class="mb-8 text-5xl max-sm:text-4xl">{title}</h1>
      </header>

      {years.map((group) => (
        <section class="mb-15 last:mb-0" aria-labelledby={`year-${group.year}`}>
          <h2 id={`year-${group.year}`} class="mb-6 text-[1.75rem]">
            {group.year} <sup class={countClass}>{group.count}</sup>
          </h2>
          <div class="grid gap-x-8 lg:grid-cols-[10rem_1fr]">
            {group.months.map((month) => (
              <>
                <h3 class="text-xl font-semibold max-lg:mb-6">
                  {month.name} <sup class={countClass}>{month.posts.length}</sup>
                </h3>
                <ul class="mb-8 grid gap-x-8 last:mb-0 sm:mb-12 md:grid-cols-2">
                  {month.posts.map((post) => (
                    <li class="mb-6 flex items-start gap-5 border-b border-line pb-6 max-sm:flex-col">
                      <a
                        href={url(postPath(post))}
                        class="block aspect-4/3 w-40 shrink-0 overflow-hidden rounded-lg max-sm:w-full"
                        tabindex="-1"
                        aria-hidden="true"
                      >
                        <OptimizedImage
                          src={post.data.image}
                          alt=""
                          widths={[320, 640]}
                          sizes="(min-width: 640px) 160px, 100vw"
                          class="size-full object-cover transition-transform duration-300 hover:scale-105"
                        />
                      </a>
                      <div class="flex min-w-0 flex-1 flex-col gap-3">
                        <h4 class="text-lg leading-snug font-semibold max-sm:text-base">
                          <a
                            href={url(postPath(post))}
                            class="underline decoration-transparent decoration-[1.4px] underline-offset-2 hover:decoration-heading"
                          >
                            {post.data.title}
                          </a>
                        </h4>
                        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-heading text-xs leading-none tracking-wide text-fg-muted uppercase">
                          <time class="text-sm" datetime={post.data.date.toISOString()}>
                            {formatDate(post.data.date)}
                          </time>
                          <span aria-hidden="true">·</span>
                          <span>{readingTime(post)}</span>
                        </div>
                      </div>
                    </li>
                  ))}
                </ul>
              </>
            ))}
          </div>
        </section>
      ))}
    </div>
  </Container>
</MainLayout>
