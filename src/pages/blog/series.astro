---
// Blog series index: every multi-part series with its parts in reading order
import MainLayout from "@src/layouts/MainLayout.astro";
import Container from "@src/components/Container.astro";
import OptimizedImage from "@src/components/OptimizedImage.astro";
import { siteData } from "@src/data/siteData";
import { url } from "@src/utils/path";
import { formatDate, getAllSeries, getPosts, postPath, readingTime } from "@src/utils/posts";
import { withBrand } from "@src/utils/seo";

const allSeries = getAllSeries(await getPosts());
const title = "Blog Series";
---

<MainLayout
  title={withBrand(title)}
  description={`Multi-part article series from the ${siteData.blog.title}: follow a topic from first steps to production, one part at a time.`}
>
  <Container as="section" class="mb-15 sm:mb-20">
    <div class="mx-auto max-w-195">
      <header class="mb-10 border-b border-line pb-8">
        <h1 class="mb-4 text-5xl max-sm:text-4xl">{title}</h1>
        <p class="text-lg text-fg-muted">
          Multi-part deep dives that build on each other. Start at Part 1 and follow along.
        </p>
      </header>

      {allSeries.map((series) => (
        <section
          id={series.id}
          class="mb-12 scroll-mt-28 rounded-2xl border border-line bg-surface-muted p-6 last:mb-0 sm:p-8"
          aria-labelledby={`${series.id}-title`}
        >
          <p class="mb-2 font-heading text-xs font-semibold tracking-wide text-primary uppercase">
            {series.posts.length} {series.posts.length === 1 ? "part" : "parts"}
          </p>
          <h2 id={`${series.id}-title`} class="mb-3 text-[1.75rem] max-sm:text-2xl">
            {series.name}
          </h2>
          <p class="mb-8 text-fg-muted">{series.description}</p>

          <ol class="space-y-6">
            {series.posts.map((post) => (
              <li class="flex items-start gap-5 max-sm:flex-col">
                <a
                  href={url(postPath(post))}
                  class="relative block aspect-4/3 w-40 shrink-0 overflow-hidden rounded-lg max-sm:w-full"
                  tabindex="-1"
                  aria-hidden="true"
                >
                  <OptimizedImage
                    src={post.data.image}
                    alt=""
                    widths={[320, 640]}
                    sizes="(min-width: 640px) 160px, 100vw"
                    class="size-full object-cover transition-transform duration-300 hover:scale-105"
                  />
                </a>
                <div class="min-w-0">
                  <p class="mb-1 font-heading text-xs font-semibold tracking-wide text-fg-muted uppercase">
                    Part {post.data.series?.part}
                  </p>
                  <h3 class="mb-2 text-lg leading-snug font-semibold">
                    <a
                      href={url(postPath(post))}
                      class="underline decoration-transparent decoration-[1.4px] underline-offset-2 hover:decoration-heading"
                    >
                      {post.data.title}
                    </a>
                  </h3>
                  <p class="font-heading text-xs tracking-wide text-fg-muted uppercase">
                    <time datetime={post.data.date.toISOString()}>
                      {formatDate(post.data.date)}
                    </time>{" "}
                    – {readingTime(post)}
                  </p>
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </Container>
</MainLayout>
