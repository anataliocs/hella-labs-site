---
// Homepage: hero, digital asset flywheel, team strip, the first page of the blog feed and a CTA
import MainLayout from "@src/layouts/MainLayout.astro";
import Hero from "@src/components/home/Hero.astro";
import TeamStrip from "@src/components/home/TeamStrip.astro";
import Flywheel from "@src/components/home/Flywheel.astro";
import PageShell from "@src/components/PageShell.astro";
import Container from "@src/components/Container.astro";
import PostFeed from "@src/components/blog/PostFeed.astro";
import CtaSection from "@src/components/content/CtaSection.astro";
import { siteData } from "@src/data/siteData";
import { homeCtaData } from "@src/data/homeData";
import { getPosts } from "@src/utils/posts";

const posts = await getPosts();
const { title, pageSize } = siteData.blog;
const hasMore = posts.length > pageSize;
---

<MainLayout
  title="Hella Labs | Fintech & Blockchain Fractional Engineering"
  description={siteData.description}
>
  <Hero />
  <Container class="mb-15 sm:mb-20">
    <Flywheel />
    <hr
      class="mt-15 h-0.5 border-0 bg-linear-to-r from-gradient-from to-gradient-to sm:mt-20"
      aria-hidden="true"
    />
  </Container>
  <TeamStrip />
  <PageShell>
    <PostFeed
      title={title}
      posts={posts.slice(0, pageSize)}
      nextUrl={hasMore ? "/page/2/" : undefined}
    />
    <CtaSection
      title={homeCtaData.title}
      button={homeCtaData.button}
      link={homeCtaData.link}
      variant="center"
      as="h2"
    >
      <p>{homeCtaData.text}</p>
    </CtaSection>
  </PageShell>
</MainLayout>
