---
// Landing page for contact-form posts made without JavaScript (the Worker redirects here)
import MainLayout from "@src/layouts/MainLayout.astro";
import Container from "@src/components/Container.astro";
import Button from "@src/components/Button.astro";
import NextSteps from "@src/components/contact/NextSteps.astro";
import { siteData } from "@src/data/siteData";
import { withBrand } from "@src/utils/seo";
---

<MainLayout
  title={withBrand("Message Sent")}
  description="Thanks for reaching out to Hella Labs. Your message has been sent and we'll get back to you soon."
  noindex
>
  <Container class="text-center">
    <h1 class="mb-5">Message sent</h1>
    <p class="mb-8 text-fg-muted">{siteData.contact.successMessage}</p>
    <NextSteps class="mx-auto mb-8 max-w-2xl" />
    <Button href="/">Back to homepage</Button>
  </Container>
</MainLayout>
