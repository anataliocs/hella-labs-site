---
// Boxed row of gradient icon tiles for the languages and technologies a post covers. Same frame
// and tile size as the sidebar social links; each tile's gradient follows the tech's brand color
// (see techStackData.ts). Hovering or focusing a tile opens a pure-CSS infobox with the tech's
// name and blurb; tiles aren't links, so the name is also exposed as visually hidden text.
import { Icon } from "astro-icon/components";
import { techStack, type TechKey } from "@src/data/techStackData";

interface Props {
  items: readonly TechKey[];
  // Accessible name for the list
  label?: string;
  // Label-maker tape stuck on the top edge of the box (decorative; `label` names the list)
  caption?: string;
  class?: string;
}

const {
  items,
  label = "Technologies covered",
  caption = "TECH STACK",
  class: className,
} = Astro.props;
// Prefix for the infobox ids (aria-describedby targets); deterministic so builds are stable
const id = "tech-blurb";
---

{items.length > 0 && (
  <div class:list={["relative rounded-2xl border border-line px-6 pt-9 pb-6", className]}>
    {caption && (
      <div class="absolute -top-2 left-1/2 -translate-x-1/2 -translate-y-1/2" aria-hidden="true">
        <span class="fx-labelmaker fx-labelmaker-brand px-4 py-2 text-sm">
          {[...caption].map((char, i) => (
            <b style={`--i: ${i}`}>{char}</b>
          ))}
        </span>
      </div>
    )}
    <ul class="flex flex-wrap items-center justify-center gap-2" aria-label={label}>
      {items.map((key) => {
        const tech = techStack[key];
        const fg = "fg" in tech ? tech.fg : "#fff";
        return (
          <li
            class="group relative"
            style={`--tech-from: ${tech.from}; --tech-to: ${tech.to}; --tech-fg: ${fg}`}
          >
            <button
              type="button"
              class="flex size-13 cursor-help items-center justify-center rounded-lg bg-linear-135 from-(--tech-from) to-(--tech-to) text-[1.375rem] text-(--tech-fg) shadow-[inset_0_0_0_1px_rgb(255_255_255/0.12)] transition-[transform,box-shadow] outline-none group-hover:-translate-y-0.5 group-hover:shadow-[0_4px_14px_-4px_var(--tech-from)] focus-visible:-translate-y-0.5 focus-visible:shadow-[0_0_0_2px_var(--color-surface),0_0_0_4px_var(--tech-from)]"
              aria-describedby={`${id}-${key}`}
            >
              <Icon name={tech.icon} aria-hidden="true" />
              <span class="sr-only">{tech.name}</span>
            </button>
            <span
              role="tooltip"
              class="pointer-events-none invisible absolute bottom-full left-1/2 z-20 mb-3 w-56 -translate-x-1/2 translate-y-1 rounded-lg border border-line bg-surface-alt px-3.5 pt-3 pb-2.5 text-left opacity-0 shadow-lg transition-[opacity,translate,visibility] duration-200 group-has-focus-visible:visible group-has-focus-visible:translate-y-0 group-has-focus-visible:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 motion-reduce:transition-none"
            >
              <span
                class="absolute inset-x-3.5 top-0 h-0.5 rounded-full bg-linear-90 from-(--tech-from) to-(--tech-to)"
                aria-hidden="true"
              ></span>
              <span
                class="block font-heading text-sm font-semibold text-heading"
                aria-hidden="true"
              >
                {tech.name}
              </span>
              <span id={`${id}-${key}`} class="mt-1 block text-xs leading-snug text-fg-muted">
                {tech.blurb}
              </span>
              <span
                class="absolute top-full left-1/2 size-2.5 -translate-x-1/2 -translate-y-1/2 rotate-45 border-r border-b border-line bg-surface-alt"
                aria-hidden="true"
              ></span>
            </span>
          </li>
        );
      })}
    </ul>
  </div>
)}
