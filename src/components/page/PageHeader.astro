---
// Header for long-form pages.
//  default – cover image (4:3) above a left-aligned title
//  icon    – centered glowing icon, title and gradient rule above a full-width image
//            (or below it, with `imageFirst`)
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import GradientIcon from "@src/components/GradientIcon.astro";
import OptimizedImage from "@src/components/OptimizedImage.astro";

interface Props {
  title: string;
  image: ImageMetadata;
  imageAlt: string;
  icon?: string;
  /** Render the title with the pure-CSS Blueprint text effect (`.fx-blueprint`) */
  blueprint?: boolean;
  /** Icon style only: show the image above the icon and title instead of below */
  imageFirst?: boolean;
}

const { title, image, imageAlt, icon, blueprint = false, imageFirst = false } = Astro.props;
const sizes = "(min-width: 1364px) 860px, (min-width: 1024px) 63vw, 100vw";
const widths = [640, 828, 1080, 1280];
---

{icon ? (
  <header class="mt-4 mb-8 text-center sm:mt-12">
    {imageFirst && (
      <OptimizedImage
        src={image}
        alt={imageAlt}
        widths={widths}
        sizes={sizes}
        class="mb-10 w-full rounded-lg shadow-md"
        priority
      />
    )}
    {blueprint ? (
      <GradientIcon
        name={icon}
        class="fx-icon-brand mx-auto mb-4 size-16 motion-safe:animate-pulse-glow"
      />
    ) : (
      <Icon
        name={icon}
        class="mx-auto mb-4 size-16 text-violet-from motion-safe:animate-pulse-glow"
        aria-hidden="true"
      />
    )}
    <h1
      class:list={[
        "mt-4 mb-2 text-[2rem] sm:text-[2.5rem]",
        blueprint && "fx-blueprint fx-blueprint-brand mx-auto w-fit",
      ]}
    >
      {title}
    </h1>
    <div
      class="mx-auto my-6 h-0.75 w-25 bg-linear-to-r from-transparent via-violet-from to-transparent"
      aria-hidden="true"
    />
    {!imageFirst && (
      <OptimizedImage
        src={image}
        alt={imageAlt}
        widths={widths}
        sizes={sizes}
        class="mt-8 w-full rounded-lg shadow-md"
        priority
      />
    )}
  </header>
) : (
  <header class="mb-7">
    <div class="relative mb-8 aspect-4/3 overflow-hidden rounded-2xl bg-surface-alt sm:mb-10">
      <OptimizedImage
        src={image}
        alt={imageAlt}
        widths={widths}
        sizes={sizes}
        class="absolute inset-0 size-full object-cover"
        priority
      />
    </div>
    <h1
      class:list={[
        "mb-5 text-[2rem] sm:mb-7 sm:text-[2.5rem]",
        blueprint && "fx-blueprint fx-blueprint-brand w-fit",
      ]}
    >
      {title}
    </h1>
  </header>
)}
