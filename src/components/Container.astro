---
// Page-width container (the theme's .container: 1364px, narrowing on smaller screens)
interface Props {
  as?: "div" | "section";
  class?: string;
}

const { as: Tag = "div", class: className } = Astro.props;
---

<Tag
  class:list={[
    "mx-auto w-full max-w-site px-5 max-lg:max-w-210 max-md:max-w-160 max-sm:max-w-120 sm:px-8",
    className,
  ]}
>
  <slot />
</Tag>
