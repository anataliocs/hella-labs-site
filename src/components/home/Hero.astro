---
// Homepage hero: glowing panel with the brand image, gradient title, Design/Build/Launch/Scale
// pillars, CTAs and the tech-stack icon row
import { Icon } from "astro-icon/components";
import Button from "@src/components/Button.astro";
import Container from "@src/components/Container.astro";
import OptimizedImage from "@src/components/OptimizedImage.astro";
import { heroData } from "@src/data/homeData";

const { title, subtitle, description, image, pillars, primaryCta, secondaryCta, stack } = heroData;
---

<section class="mb-15 sm:mb-17.5">
  <Container>
    <div class="rounded-[10px] bg-surface-muted p-6 shadow-glow sm:p-8">
      <div class="grid items-center gap-x-8 gap-y-10 lg:grid-cols-2">
        <div class="relative aspect-4/3 overflow-hidden rounded-2xl bg-surface shadow-card select-none max-lg:order-last lg:aspect-auto lg:h-133.5">
          <OptimizedImage
            src={image.src}
            alt={image.alt}
            widths={[640, 828, 1080, 1195]}
            sizes="(min-width: 1364px) 634px, (min-width: 1024px) 46vw, 100vw"
            class="absolute inset-0 size-full object-cover"
            priority
          />
        </div>

        <div class="mx-auto max-w-145 text-center lg:mx-0">
          <div class="my-6 flex justify-center text-heading motion-safe:animate-hue">
            <Icon
              name="fa6-solid:laptop-code"
              class="icon-glow size-12 motion-safe:animate-bounce"
              aria-hidden="true"
            />
          </div>

          <div class="mx-auto my-3 w-fit">
            <h1 class="fx-scanner fx-scanner-brand text-[2.875rem] leading-tight sm:text-hero sm:leading-[1.3]">
              {title}
            </h1>
            <div class="h-0.5 bg-brand-gradient" aria-hidden="true"></div>
          </div>

          <p class="mb-5 font-heading text-lg font-medium text-fg sm:mb-6 sm:text-xl">{subtitle}</p>

          <ul class="mb-4 flex flex-wrap justify-center gap-x-4 gap-y-1 font-bold">
            {pillars.map((pillar) => (
              <li class="flex items-center gap-1.5">
                <Icon name={pillar.icon} class="size-4 text-primary" aria-hidden="true" />
                <span class="text-gradient">{pillar.label}</span>
              </li>
            ))}
          </ul>
          <p class="mb-4 text-base sm:text-lg">{description}</p>

          <div class="mt-2 flex flex-wrap justify-center gap-3 sm:mt-4">
            <Button href={primaryCta.href} icon={primaryCta.icon}>
              {primaryCta.label}
            </Button>
            <Button
              href={secondaryCta.href}
              icon={secondaryCta.icon}
              variant="secondary"
              rel="nofollow"
              label="Send us a direct message on Telegram"
            >
              {secondaryCta.label}
            </Button>
          </div>

          <div class="my-5">
            <div class="mt-6 mb-4 h-px bg-brand-gradient opacity-40" aria-hidden="true"></div>
            <ul
              class="flex flex-wrap justify-center gap-2.5 text-lg text-heading motion-safe:animate-hue-slow sm:text-2xl"
              aria-label="Technologies we work with"
            >
              {stack.map((tech) => (
                <li>
                  <Icon name={tech.icon} class="icon-glow-sm" aria-label={tech.name} role="img" />
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
