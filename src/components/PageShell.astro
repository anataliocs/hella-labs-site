---
// Two-column page body: content (8/12) + sidebar widgets (4/12), stacked below lg
import Container from "@src/components/Container.astro";
import Sidebar from "@src/components/sidebar/Sidebar.astro";

interface Props {
  // Post shown on this page, left out of the sidebar's featured posts
  currentPostId?: string;
  class?: string;
}

const { currentPostId, class: className } = Astro.props;
---

<Container class={className}>
  <div class="grid gap-x-8 lg:grid-cols-12">
    <div class="min-w-0 lg:col-span-8">
      <slot />
    </div>
    <div class="mt-15 sm:mt-20 lg:col-span-4 lg:mt-0">
      <Sidebar currentPostId={currentPostId} />
    </div>
  </div>
</Container>
