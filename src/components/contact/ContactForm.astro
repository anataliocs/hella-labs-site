---
// Contact form, posted to the Cloudflare Worker at /api/contact (worker/index.ts), which validates
// it and emails it (worker/formEmail.ts builds the HTML + plain-text message).
// With JS, Alpine submits it via fetch and shows the result inline; without JS it's a normal POST
// and the Worker redirects to /contact/thanks/.
import { Icon } from "astro-icon/components";
import Button from "@src/components/Button.astro";
import NextSteps from "@src/components/contact/NextSteps.astro";
import { siteData } from "@src/data/siteData";
import { url } from "@src/utils/path";

const { formAction, buttonText, sendingText, successMessage, errorMessage, inquiryTypes } =
  siteData.contact;
const fieldClass =
  "w-full resize-y rounded-xl border-[1.4px] border-line-alt bg-surface-muted py-4 pr-5 pl-13 text-base text-heading outline-none transition placeholder:text-fg-muted focus:border-primary focus:bg-transparent focus:shadow-focus-glow focus:outline-2 focus:outline-offset-4 focus:outline-primary focus:placeholder:text-heading";
// Icon embedded at the left of each field (fields have pl-13 to make room). Single-line fields
// center it; the textarea pins it to the first line. The icon turns primary while its field has
// focus (the wrapper is a `group`).
const iconClass =
  "pointer-events-none absolute left-5 size-4.5 text-fg-muted transition-colors group-focus-within:text-primary";
const iconCentered = `${iconClass} top-1/2 -translate-y-1/2`;
const iconTop = `${iconClass} top-4.75`;
---

<form
  class="space-y-5"
  action={url(formAction)}
  method="POST"
  data-sending={sendingText}
  data-success={successMessage}
  data-error={errorMessage}
  x-data="{
    status: 'idle',
    message: '',
    async submit(form) {
      this.status = 'sending';
      this.message = '';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error(data.error);
        form.reset();
        this.status = 'sent';
        this.message = form.dataset.success;
        // Lets the page react (contact.astro hides its intro once the message is sent)
        window.dispatchEvent(new CustomEvent('contact-sent'));
      } catch (err) {
        this.message = err.message || form.dataset.error;
        this.status = 'error';
      }
    },
  }"
  @submit.prevent="submit($el)"
  @pageshow.window="if ($event.persisted) { status = 'idle'; message = ''; $el.reset(); }"
>
  <fieldset class="space-y-5" :disabled="status === 'sending'" x-show="status !== 'sent'">
    <div class="group relative">
      <label class="sr-only" for="form-name">
        Name
      </label>
      <Icon name="fa6-solid:id-badge" class={iconCentered} aria-hidden="true" />
      <input
        class={fieldClass}
        id="form-name"
        type="text"
        name="name"
        placeholder="Name"
        autocomplete="name"
        maxlength="200"
        required
      />
    </div>
    <div class="group relative">
      <label class="sr-only" for="form-email">
        Email
      </label>
      <Icon name="fa6-solid:envelope" class={iconCentered} aria-hidden="true" />
      <input
        class={fieldClass}
        id="form-email"
        type="email"
        name="email"
        placeholder="Email"
        autocomplete="email"
        maxlength="254"
        required
      />
    </div>
    <div class="group relative">
      <label class="sr-only" for="form-inquiry">
        Inquiry Type
      </label>
      <Icon name="fa6-solid:list-check" class={iconCentered} aria-hidden="true" />
      <select class={fieldClass} id="form-inquiry" name="inquiry_type" required>
        <option value="">Select Inquiry Type</option>
        {inquiryTypes.map((type) => (
          <option value={type}>{type}</option>
        ))}
      </select>
    </div>
    <div class="group relative">
      <label class="sr-only" for="form-text">
        Message
      </label>
      <Icon name="fa6-solid:comment-dots" class={iconTop} aria-hidden="true" />
      <textarea
        class={fieldClass}
        id="form-text"
        name="text"
        rows="5"
        placeholder="What do you want to build today?"
        maxlength="5000"
        required
      ></textarea>
    </div>
    <!-- Spam honeypot: hidden from people and assistive tech, but bots tend to fill it in -->
    <div class="hidden" aria-hidden="true">
      <label for="form-company">Company</label>
      <input id="form-company" type="text" name="company" tabindex="-1" autocomplete="off" />
    </div>
    <div>
      <Button type="submit" icon="fa6-brands:space-awesome">
        <span
          x-text="status === 'sending' ? $root.dataset.sending : $el.dataset.label"
          data-label={buttonText}
        >
          {buttonText}
        </span>
      </Button>
    </div>
  </fieldset>
  <p
    class="text-base empty:hidden"
    role="status"
    x-text="message"
    :class="status === 'error' ? 'text-red-600 dark:text-red-400' : 'text-heading'"
  ></p>
  <div x-show="status === 'sent'" x-cloak>
    <NextSteps />
  </div>
</form>
