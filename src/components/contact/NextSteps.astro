---
// Numbered "what happens next" list shown after a contact submission (form + thanks page)
import { Icon } from "astro-icon/components";
import Button from "@src/components/Button.astro";
import { siteData } from "@src/data/siteData";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const { title, steps, notes, ctaLabel, blogLink } = siteData.contact.nextSteps;
---

<section
  class:list={["rounded-xl border border-line bg-surface-alt p-6 text-left", className]}
  aria-labelledby="next-steps-heading"
>
  <h2 id="next-steps-heading" class="mb-5 text-xl">
    {title}
  </h2>
  <ol class="space-y-4">
    {steps.map((step) => (
      <li class="flex items-start gap-4">
        <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-primary/15 text-primary">
          <Icon name={step.icon} class="size-4.5" aria-hidden="true" />
        </span>
        <p class="pt-2 text-base text-heading">{step.text}</p>
      </li>
    ))}
  </ol>
  <div class="mt-6 space-y-2 border-t border-line pt-5 text-sm text-fg-muted">
    {notes.map((note) => (
      <p>{note}</p>
    ))}
  </div>
  <div class="mt-6 flex flex-wrap gap-3">
    <Button href={siteData.contact.directMessage} variant="secondary" icon="fa6-brands:telegram">
      {ctaLabel}
    </Button>
    <Button href={blogLink.href} variant="light" icon="fa6-solid:book-open">
      {blogLink.label}
    </Button>
  </div>
</section>
