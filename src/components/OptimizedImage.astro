---
// Responsive <picture>: AVIF + WebP sources with a JPEG/PNG fallback, a srcset built from
// `widths`, and width/height set at build time to prevent layout shift. Pass `sizes` to match how
// wide the image renders so the browser picks the smallest file.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { PICTURE_FORMATS } from "@src/utils/images";

interface Props {
  src: ImageMetadata;
  alt: string;
  // Candidate widths in px; anything wider than the source image is dropped
  widths: number[];
  sizes: string;
  class?: string;
  // LCP / key above-the-fold images: eager load + fetchpriority="high"
  priority?: boolean;
  // <picture> is `display: contents` so the <img> lays out exactly like a bare <img>
  pictureClass?: string;
}

const {
  src,
  alt,
  widths,
  sizes,
  class: className,
  priority = false,
  pictureClass = "contents [&>source]:hidden",
} = Astro.props;

const usable = widths.filter((w) => w <= src.width);
const candidates = usable.length ? usable : [src.width];
const width = Math.max(...candidates);
const height = Math.round((src.height / src.width) * width);
---

<Picture
  src={src}
  alt={alt}
  width={width}
  height={height}
  widths={candidates}
  sizes={sizes}
  formats={[...PICTURE_FORMATS]}
  priority={priority}
  class={className}
  pictureAttributes={{ class: pictureClass }}
/>
