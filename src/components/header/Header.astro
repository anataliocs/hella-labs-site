---
// Sticky glass header: logo, nav with hover/focus dropdowns (desktop) or a hamburger panel
// (below lg), theme toggle and the rocket CTA.
import { Icon } from "astro-icon/components";
import Logo from "@src/components/header/Logo.astro";
import ThemeToggle from "@src/components/header/ThemeToggle.astro";
import Button from "@src/components/Button.astro";
import { latestPostHref, mainNav, navCta } from "@src/data/navigationData";
import { isActivePath, url } from "@src/utils/path";
import { getPosts, postPath } from "@src/utils/posts";

const pathname = Astro.url.pathname;
// Link "Latest Post" straight to the newest article instead of through the /blog/latest/ redirect
const [latestPost] = await getPosts();
const resolveNav = (href: string) =>
  href === latestPostHref && latestPost ? postPath(latestPost) : href;
const linkClass =
  "flex items-center gap-2 rounded-lg px-4 py-2 font-heading lg:max-xl:px-2.5 text-nav leading-6 font-medium tracking-normal hover:bg-surface-alt aria-[current=page]:bg-surface-alt max-lg:px-3 max-lg:py-1.5 max-lg:leading-snug";
---

<header class="sticky top-0 z-30 mb-12 border-b border-line bg-surface-glass backdrop-blur-md backdrop-saturate-180 sm:mb-15">
  <div
    class="relative flex flex-wrap items-center justify-between p-4 sm:px-8 lg:flex-nowrap"
    x-data="{ open: false }"
    x-init="matchMedia('(min-width: 64rem)').addEventListener('change', (e) => e.matches && (open = false)); $watch('open', (v) => document.documentElement.classList.toggle('max-lg:overflow-hidden', v))"
    x-on:keydown.escape="open = false"
    x-on:click.outside="open = false"
  >
    <a href={url("/")} class="shrink-0" aria-label="Hella Labs home">
      <Logo />
    </a>

    <nav
      id="main-nav"
      aria-label="Main menu"
      class="flex-1 not-data-open:max-lg:hidden max-lg:absolute max-lg:inset-x-0 max-lg:top-full max-lg:z-50 max-lg:h-(--nav-h) max-lg:overflow-y-auto max-lg:overscroll-contain max-lg:border-t max-lg:border-line max-lg:bg-surface max-lg:px-4 max-lg:py-5 max-lg:sm:px-8 lg:ml-6 xl:ml-12 dark:max-lg:bg-surface-muted"
      x-bind:data-open="open"
      x-bind:style="open && { '--nav-h': `calc(100dvh - ${$el.parentElement.getBoundingClientRect().bottom}px)` }"
    >
      <ul class="flex items-center gap-3 lg:max-xl:gap-1 max-lg:flex-col max-lg:items-stretch max-lg:gap-1">
        {mainNav.map((item) => {
          // Parents are also active on any child page (e.g. About on /brand-kit/)
          const active =
            isActivePath(pathname, item.href) ||
            !!item.children?.some((child) => isActivePath(pathname, child.href, child.exact));
          return (
            <li
              class:list={["relative", item.children && "group"]}
              x-data={item.children ? `{ expanded: ${active} }` : undefined}
            >
              <a
                href={url(item.href)}
                class:list={[linkClass, item.children && "max-lg:hidden"]}
                aria-current={active ? "page" : undefined}
              >
                <Icon name={item.icon} class="size-3.5 shrink-0 opacity-70" aria-hidden="true" />
                {item.title}
                {item.children && (
                  <Icon
                    name="fa6-solid:chevron-down"
                    class="size-2.5 opacity-70 max-lg:hidden"
                    aria-hidden="true"
                  />
                )}
              </a>
              {item.children && (
                <button
                  type="button"
                  class:list={[linkClass, "w-full lg:hidden"]}
                  aria-controls={`nav-${item.title.toLowerCase().replace(/\W+/g, "-")}`}
                  x-bind:aria-expanded="expanded"
                  x-on:click="expanded = !expanded"
                >
                  <Icon name={item.icon} class="size-3.5 shrink-0 opacity-70" aria-hidden="true" />
                  {item.title}
                  <Icon
                    name="fa6-solid:chevron-down"
                    class="ml-auto size-3 opacity-70 transition-transform"
                    x-bind:class="expanded && 'rotate-180'"
                    aria-hidden="true"
                  />
                </button>
              )}
              {item.children && (
                <ul
                  id={`nav-${item.title.toLowerCase().replace(/\W+/g, "-")}`}
                  aria-label={`${item.title} pages`}
                  x-bind:class="!expanded && 'max-lg:hidden'"
                  class="lg:invisible lg:absolute lg:top-full lg:-left-6 lg:z-50 lg:mt-3 lg:min-w-64 lg:rounded-xl lg:border lg:border-line lg:bg-surface lg:p-3 lg:opacity-0 lg:shadow-popover lg:transition-all lg:group-focus-within:visible lg:group-focus-within:opacity-100 lg:group-hover:visible lg:group-hover:opacity-100 lg:before:absolute lg:before:inset-x-0 lg:before:-top-3 lg:before:h-3 dark:lg:bg-surface-muted max-lg:pt-1 max-lg:pb-2 max-lg:pl-3"
                >
                  <li class="mb-1 lg:hidden">
                    <a
                      href={url(item.href)}
                      class={linkClass}
                      aria-current={isActivePath(pathname, item.href, true) ? "page" : undefined}
                    >
                      <Icon
                        name={item.icon}
                        class="size-4 shrink-0 text-primary"
                        aria-hidden="true"
                      />
                      {item.title} overview
                    </a>
                  </li>
                  {item.children.map((child) => (
                    <li class="mb-1 last:mb-0">
                      <a
                        href={url(resolveNav(child.href))}
                        class={linkClass}
                        aria-current={
                          isActivePath(pathname, resolveNav(child.href), child.exact)
                            ? "page"
                            : undefined
                        }
                      >
                        <Icon
                          name={child.icon}
                          class="size-4 shrink-0 text-primary"
                          aria-hidden="true"
                        />
                        {child.title}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="ml-auto flex items-center max-lg:mr-2">
      <div class="mr-6 border-r border-line-alt pr-4 lg:max-xl:mr-3 lg:max-xl:pr-3 max-lg:mr-2 max-lg:pr-2">
        <ThemeToggle />
      </div>
      <Button href={navCta.href} size="sm" icon="fa6-solid:rocket" label={navCta.label} />
    </div>

    <button
      type="button"
      class="group/burger relative flex size-6 items-center justify-center lg:hidden"
      aria-controls="main-nav"
      aria-label="Open menu"
      x-bind:aria-expanded="open"
      x-bind:aria-label="open ? 'Close menu' : 'Open menu'"
      x-on:click="open = !open"
    >
      <span class="relative h-0.75 w-5.5 rounded-full bg-fg-muted transition-all duration-150 group-hover/burger:bg-heading group-aria-expanded/burger:bg-transparent before:absolute before:left-0 before:h-0.75 before:w-5.5 before:-translate-y-[200%] before:rounded-full before:bg-fg-muted before:transition-all before:duration-150 after:absolute after:left-0 after:h-0.75 after:w-5.5 after:translate-y-[200%] after:rounded-full after:bg-fg-muted after:transition-all after:duration-150 group-hover/burger:before:bg-heading group-hover/burger:after:bg-heading group-aria-expanded/burger:before:translate-y-0 group-aria-expanded/burger:before:rotate-45 group-aria-expanded/burger:after:translate-y-0 group-aria-expanded/burger:after:-rotate-45"></span>
    </button>
  </div>
</header>
