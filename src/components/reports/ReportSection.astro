---
// One Lighthouse run: device + date heading, category score gauges, key lab metrics and a link
// to the full HTML report (opens in a new tab)
import { Icon } from "astro-icon/components";
import ScoreGauge from "@src/components/reports/ScoreGauge.astro";
import SectionHeading from "@src/components/SectionHeading.astro";
import { lighthouseData } from "@src/data/lighthouseData";
import { type Report, reportHtmlUrl, toPercent } from "@src/utils/reports";

interface Props {
  report: Report;
}

const { report } = Astro.props;
const { fetchTime, lighthouseVersion, finalDisplayedUrl, configSettings, categories, audits } =
  report.data;
const device = lighthouseData.devices[configSettings.formFactor];
const htmlUrl = reportHtmlUrl(report);

const runDate = fetchTime.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
const metrics = lighthouseData.metrics.flatMap((id) => {
  const audit = audits[id];
  return audit?.displayValue ? [{ id, title: audit.title, value: audit.displayValue }] : [];
});
---

<section class="mt-15 sm:mt-20">
  <SectionHeading title={`${device.label} report`}>
    <span class="bg-surface pl-4">
      <Icon name={device.icon} class="size-8 text-primary" aria-hidden="true" />
    </span>
  </SectionHeading>

  <p class="mb-2 text-base">{device.note}</p>
  <p class="mb-8 font-heading text-sm text-fg-muted">
    Audited{" "}
    <a class="text-heading underline underline-offset-2" href={finalDisplayedUrl}>
      {finalDisplayedUrl}
    </a>{" "}
    on <time datetime={fetchTime.toISOString()}>{runDate}</time> with Lighthouse {lighthouseVersion}
    .
  </p>

  <div class="rounded-lg border border-line bg-surface-alt p-6 sm:p-8">
    <ul class="flex flex-wrap justify-center gap-6 sm:gap-8" aria-label="Category scores">
      {Object.entries(categories).map(([, category]) => (
        <li>
          <ScoreGauge score={toPercent(category.score)} label={category.title} />
        </li>
      ))}
    </ul>

    {metrics.length > 0 && (
      <dl class="mt-8 grid grid-cols-2 gap-4 border-t border-line pt-6 sm:grid-cols-3 lg:grid-cols-5">
        {metrics.map((metric) => (
          <div>
            <dt class="font-heading text-sm text-fg-muted">{metric.title}</dt>
            <dd class="font-heading text-xl font-semibold text-heading">{metric.value}</dd>
          </div>
        ))}
      </dl>
    )}
  </div>

  {htmlUrl && (
    <p class="mt-4 text-right">
      <a
        class="font-heading text-sm font-medium text-heading underline underline-offset-2"
        href={htmlUrl}
        target="_blank"
        rel="noopener"
      >
        View the full {device.label.toLowerCase()} report
      </a>
    </p>
  )}
</section>
