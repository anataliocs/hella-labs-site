---
import type { ImageMetadata } from "astro";
import { Font, getImage } from "astro:assets";
import Header from "@src/components/header/Header.astro";
import Footer from "@src/components/footer/Footer.astro";
import ScrollTopButton from "@src/components/ScrollTopButton.astro";
import "@src/styles/style.css";
import { siteData } from "@src/data/siteData";
import { url } from "@src/utils/path";
import { getShareImage } from "@src/utils/images";
import { clip, siteJsonLd } from "@src/utils/seo";

interface Props {
  // Full <title>, unique per URL (≤ ~60 chars). Use withBrand() from utils/seo for most pages.
  title: string;
  // Unique per URL (clipped to 160 chars)
  description: string;
  // Social share image; falls back to the default brand image
  image?: ImageMetadata;
  imageAlt?: string;
  ogType?: "website" | "article";
  article?: { publishedTime: Date; modifiedTime?: Date; tags?: string[] };
  keywords?: string[];
  // Page-specific structured data, rendered after the site-wide Organization/WebSite graph
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  // Full-screen pages (contact) render without the site header and footer
  bare?: boolean;
  noindex?: boolean;
}

const {
  title,
  description: rawDescription,
  image,
  imageAlt,
  ogType = "website",
  article,
  keywords = siteData.keywords,
  jsonLd,
  bare = false,
  noindex = false,
} = Astro.props;

const description = clip(rawDescription);

// Canonical URL: `site` + the current path with a trailing slash (matches `trailingSlash`)
const pathname = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = new URL(pathname, Astro.site).href;

const ogImage = await getShareImage(image ?? siteData.defaultImage.src);
const ogImageAlt = image ? (imageAlt ?? title) : siteData.defaultImage.alt;

const logo = await getImage({ src: siteData.logo.light, width: 512, format: "png" });
const structuredData = [
  siteJsonLd(new URL(logo.src, import.meta.env.SITE).href),
  ...(jsonLd ? [jsonLd].flat() : []),
];
---

<!doctype html>
<html lang="en" class="dark" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteData.legalName} />
    <meta name="keywords" content={keywords.join(", ")} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <meta name="theme-color" content={siteData.themeColor} />
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" type="image/png" href={url("/favicon.png")} />
    <link rel="icon" href={url("/favicon.ico")} sizes="any" />
    <link rel="sitemap" type="application/xml" href={url("/sitemap-index.xml")} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteData.title}
      href={url("/feed.xml")}
    />

    <!-- Theme + blog view before first paint: dark is the default, the visitor's choice wins -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          const dark = root.classList.toggle(
            "dark",
            (localStorage.getItem("theme") ?? "dark") === "dark",
          );
          // Mirrored for astro-mermaid, which picks its diagram theme from data-theme
          root.dataset.theme = dark ? "dark" : "light";
          root.classList.toggle("view-list", localStorage.getItem("classView") === "list");
        } catch {
          // Storage blocked (private mode): keep the defaults
        }
      })();
    </script>

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteData.title} />
    <meta property="og:locale" content={siteData.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:image" content={ogImage.url} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    {article && (
      <>
        <meta property="article:published_time" content={article.publishedTime.toISOString()} />
        <meta
          property="article:modified_time"
          content={(article.modifiedTime ?? article.publishedTime).toISOString()}
        />
        {article.tags?.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={siteData.twitterHandle} />
    <meta name="twitter:creator" content={siteData.twitterHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.url} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Structured data -->
    {structuredData.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}

    <Font cssVariable="--font-poppins" preload={[{ weight: "700" }]} />
    <Font cssVariable="--font-roboto-mono" preload={[{ weight: "400", style: "normal" }]} />

    <slot name="head" />
  </head>
  <body class:list={["flex min-h-dvh flex-col", bare && "lg:h-dvh"]}>
    {!bare && <Header />}
    <main id="content" class="flex-1">
      <slot />
    </main>
    {!bare && <Footer />}
    {!bare && <ScrollTopButton />}

    <script>
      import Alpine from "alpinejs";
      declare global {
        interface Window {
          Alpine: typeof Alpine;
        }
      }
      window.Alpine = Alpine;
      Alpine.start();
    </script>
  </body>
</html>
