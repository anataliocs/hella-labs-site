// Cloudflare Workers static-assets deploy (`pnpm deploy`). The site is fully static: wrangler
// uploads dist/ as-is; there is no Worker script or bindings.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hella-labs-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
